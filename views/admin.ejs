<%- include('partials/header') %>

<div class="container my-5">
  <h1 class="text-center mb-4">Admin Properti</h1>

  <!-- Form Tambah Properti -->
  <form action="/admin/add" method="POST" enctype="multipart/form-data" class="border p-4 rounded bg-light mb-5">
    <h4>Tambah Properti Baru</h4>
    <div class="row">
      <div class="col-md-6 mb-3">
        <label>Judul</label>
        <input type="text" name="title" class="form-control" required>
      </div>
      <div class="col-md-3 mb-3">
        <label>Harga</label>
        <input type="number" name="price" class="form-control" required>
      </div>
      <div class="col-md-3 mb-3">
        <label>Tipe</label>
        <select name="type" class="form-select">
          <option value="house">Rumah</option>
          <option value="car">Mobil</option>
        </select>
      </div>
    </div>
    <div class="row">
      <div class="col-md-6 mb-3">
        <label>Lokasi</label>
        <input type="text" name="location" class="form-control" required>
      </div>
      <div class="col-md-6 mb-3">
        <label>Kontak (WA)</label>
        <input type="text" name="contact" class="form-control" required>
      </div>
    </div>
    <div class="mb-3">
      <label>Upload Gambar/Video (bisa banyak)</label>
      <input type="file" name="media" class="form-control" accept="image/*,video/*" multiple required>
    </div>
    <button type="submit" class="btn btn-success w-100">Tambah Properti</button>
  </form>

  <!-- Daftar Properti -->
  <h4>Daftar Properti</h4>
  <table class="table table-bordered align-middle">
    <thead class="table-secondary">
      <tr>
        <th>Judul</th>
        <th>Harga</th>
        <th>Lokasi</th>
        <th>Tipe</th>
        <th>Media</th>
        <th>Aksi</th>
      </tr>
    </thead>
    <tbody>
      <% listings.forEach(item => { %>
        <tr>
          <td><%= item.title %></td>
          <td>Rp <%= Number(item.price).toLocaleString('id-ID') %></td>
          <td><%= item.location %></td>
          <td><%= item.type %></td>
          <td>
            <% item.media.slice(0,2).forEach(m => { %>
              <% if (m.type === 'image') { %>
                <img src="/uploads/<%= m.src %>" alt="" width="50" height="50" class="rounded me-1">
              <% } else { %>
                🎥
              <% } %>
            <% }) %>
          </td>
          <td>
            <form action="/admin/delete/<%= item.id %>" method="POST" onsubmit="return confirm('Yakin ingin hapus?')">
              <button class="btn btn-sm btn-danger">Hapus</button>
            </form>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>

<%- include('partials/footer') %>
