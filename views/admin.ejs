<%- include('partials/header') %>

<div class="container my-5">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h3 class="fw-bold text-dark">📋 Daftar Properti</h3>
    <% if (username) { %>
      <div>
        <span class="me-3 text-muted">👋 Halo, <strong><%= username %></strong></span>
        <a href="/<%= PATH_PROXY %>/logout" class="btn btn-danger btn-sm">Logout</a>
        <a href="/<%= PATH_PROXY %>/admin/form" class="btn btn-success btn-sm ms-2">
          <i class="bi bi-plus-lg"></i> Tambah Properti
        </a>
      </div>
    <% } else { %>
      <a href="/<%= PATH_PROXY %>/login" class="btn btn-primary btn-sm">Login</a>
    <% } %>
  </div>

  <% if (!listings || listings.length === 0) { %>
    <div class="alert alert-info text-center">
      Belum ada properti yang ditambahkan.
    </div>
  <% } else { %>
    <div class="row g-4">
      <% listings.forEach(item => { %>
        <div class="col-md-4">
          <div class="card h-100 shadow-sm border-0">
            <% if (item.media && item.media.length > 0) { %>
              <% const cover = item.media[0]; %>
              <% if (cover.type === 'video') { %>
                <video class="card-img-top" controls style="height: 200px; object-fit: cover;">
                  <source src="/<%= PATH_PROXY %>/uploads/<%= cover.src %>" type="video/mp4">
                </video>
              <% } else { %>
                <img src="/<%= PATH_PROXY %>/uploads/<%= cover.src %>" class="card-img-top" alt="<%= item.title %>" style="height: 200px; object-fit: cover;">
              <% } %>
            <% } else { %>
              <div class="bg-secondary d-flex align-items-center justify-content-center text-white" style="height:200px;">
                <i class="bi bi-image" style="font-size:2rem;"></i>
              </div>
            <% } %>

            <div class="card-body">
              <h5 class="card-title text-dark mb-1"><%= item.title %></h5>
              <p class="text-muted small mb-1">
                <i class="bi bi-geo-alt"></i> <%= item.location %>
              </p>
              <p class="fw-bold text-success mb-2">
                Rp <%= Number(item.price).toLocaleString('id-ID') %>
              </p>
              <p class="text-truncate"><%= item.description %></p>
            </div>

            <div class="card-footer bg-light border-0 d-flex justify-content-between">
              <a href="/<%= PATH_PROXY %>/admin/form/<%= item.id %>" class="btn btn-sm btn-warning">Edit</a>
              <a href="/<%= PATH_PROXY %>/admin/delete/<%= item.id %>" class="btn btn-sm btn-danger" onclick="return confirm('Yakin ingin menghapus properti ini?')">
                <i class="bi bi-trash"></i> Hapus
              </a>
            </div>
          </div>
        </div>
      <% }); %>
    </div>
  <% } %>
</div>

<%- include('partials/footer') %>

<% if (pagination.totalPages > 1) { %>
  <nav class="mt-4">
    <ul class="pagination justify-content-center">
      <% for (let i = 1; i <= pagination.totalPages; i++) { %>
        <li class="page-item <%= i === pagination.currentPage ? 'active' : '' %>">
          <a class="page-link" href="/<%= PATH_PROXY %>/admin?page=<%= i %>"><%= i %></a>
        </li>
      <% } %>
    </ul>
  </nav>
<% } %>

