<%- include('partials/header') %>

<div class="container my-5">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="mb-0">Admin Properti</h1>
    <a href="/logout" class="btn btn-outline-danger btn-sm">Logout</a>
  </div>

  <!-- 🏠 Form Tambah Properti -->
  <form action="/admin/save" method="POST" enctype="multipart/form-data" class="border p-4 rounded bg-light shadow-sm mb-5">
    <h4 class="mb-3">Tambah Properti Baru</h4>

    <div class="row">
      <div class="col-md-6 mb-3">
        <label class="form-label fw-semibold">Judul</label>
        <input type="text" name="title" class="form-control" placeholder="Judul properti..." required>
      </div>
      <div class="col-md-3 mb-3">
        <label class="form-label fw-semibold">Harga (Rp)</label>
        <input type="number" name="price" class="form-control" required>
      </div>
      <div class="col-md-3 mb-3">
        <label class="form-label fw-semibold">Tipe</label>
        <select name="type" class="form-select">
          <option value="house">Rumah</option>
          <option value="car">Mobil</option>
        </select>
      </div>
    </div>

    <div class="row">
      <div class="col-md-6 mb-3">
        <label class="form-label fw-semibold">Lokasi</label>
        <input type="text" name="location" class="form-control" required>
      </div>
      <div class="col-md-6 mb-3">
        <label class="form-label fw-semibold">Kontak (No. WhatsApp)</label>
        <input type="text" name="contact" class="form-control" placeholder="628xxxxxxxxxx" required>
      </div>
    </div>

    <div class="mb-3">
      <label class="form-label fw-semibold">Deskripsi Properti</label>
      <textarea name="description" rows="3" class="form-control" placeholder="Tuliskan deskripsi properti..." required></textarea>
    </div>

    <div class="mb-3">
      <label class="form-label fw-semibold">Upload Gambar / Video (bisa banyak)</label>
      <input type="file" name="media" id="mediaInput" class="form-control" accept="image/*,video/*" multiple required>
      <div id="previewArea" class="mt-3 d-flex flex-wrap gap-2"></div>
    </div>

    <div class="mb-3">
      <label class="form-label fw-semibold">Caption Tiap Media (opsional)</label>
      <small class="d-block text-muted mb-1">Pisahkan setiap caption dengan baris baru (urutan sesuai media)</small>
      <textarea name="captions" rows="3" class="form-control" placeholder="Contoh:\nTampak depan rumah\nVideo ruang tamu"></textarea>
    </div>

    <button type="submit" class="btn btn-success w-100 py-2 fw-semibold">💾 Simpan Properti</button>
  </form>

  <!-- 📋 Daftar Properti -->
  <h4 class="mb-3">Daftar Properti Tersimpan</h4>
  <table class="table table-bordered align-middle shadow-sm">
    <thead class="table-secondary text-center">
      <tr>
        <th>Judul</th>
        <th>Harga</th>
        <th>Lokasi</th>
        <th>Tipe</th>
        <th>Media</th>
        <th>Deskripsi</th>
        <th>Aksi</th>
      </tr>
    </thead>
    <tbody>
      <% if (listings.length === 0) { %>
        <tr>
          <td colspan="7" class="text-center text-muted py-4">Belum ada properti yang tersimpan</td>
        </tr>
      <% } else { %>
        <% listings.forEach(item => { %>
          <tr>
            <td><%= item.title %></td>
            <td>Rp <%= Number(item.price).toLocaleString('id-ID') %></td>
            <td><%= item.location %></td>
            <td><%= item.type %></td>
            <td>
              <% item.media.slice(0,3).forEach(m => { %>
                <% if (m.type === 'image') { %>
                  <img src="/uploads/<%= m.src %>" alt="" width="50" height="50" class="rounded me-1 shadow-sm">
                <% } else { %>
                  🎥 <small>(video)</small>
                <% } %>
              <% }) %>
            </td>
            <td><small><%= item.description || '-' %></small></td>
            <td class="text-center">
              <form action="/admin/delete/<%= item.id %>" method="POST" onsubmit="return confirm('Yakin ingin menghapus data ini?')">
                <button class="btn btn-sm btn-danger px-3">Hapus</button>
              </form>
            </td>
          </tr>
        <% }) %>
      <% } %>
    </tbody>
  </table>
</div>

<!-- 🧠 JS Preview Gambar/Video -->
<script>
  const mediaInput = document.getElementById('mediaInput');
  const previewArea = document.getElementById('previewArea');

  mediaInput.addEventListener('change', function() {
    previewArea.innerHTML = '';
    Array.from(this.files).forEach(file => {
      const url = URL.createObjectURL(file);
      const wrapper = document.createElement('div');
      wrapper.style.width = '120px';
      wrapper.style.textAlign = 'center';
      wrapper.classList.add('p-1', 'border', 'rounded');

      if (file.type.startsWith('image')) {
        wrapper.innerHTML = `<img src="${url}" class="img-fluid rounded" style="height:80px;object-fit:cover;"><br><small>${file.name}</small>`;
      } else if (file.type.startsWith('video')) {
        wrapper.innerHTML = `<video src="${url}" style="width:100%;height:80px;object-fit:cover;" muted></video><br><small>${file.name}</small>`;
      }

      previewArea.appendChild(wrapper);
    });
  });
</script>

<%- include('partials/footer') %>
