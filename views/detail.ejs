<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <title><%= item.title %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
  <% include partials/navbar.ejs %>
  <div class="container">
    <a href="<%= PATH_PROXY %>/" class="btn btn-secondary mb-3">← Kembali</a>
    <div class="card mb-4">
      <img src="<%= PATH_PROXY %>/<%= item.image %>" class="card-img-top" style="height:400px;object-fit:cover">
      <div class="card-body">
        <h3><%= item.title %></h3>
        <p class="text-muted">Rp <%= item.price %></p>
        <p><%= item.description %></p>
        <a href="https://wa.me/<%= wa %>?text=Halo, saya tertarik dengan <%= item.title %>" class="btn btn-success" target="_blank">Hubungi via WhatsApp</a>
      </div>
    </div>
  </div>
</body>
</html>
